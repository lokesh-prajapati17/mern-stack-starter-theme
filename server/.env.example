# ==========================================
# Server Environment Configuration (.env)
# ==========================================

PORT=5005
NODE_ENV=development

# Allowed client origins (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/custom_setup_mern

# JWT Access & Refresh Token Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production_12345
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_67890
JWT_REFRESH_EXPIRE=7d
